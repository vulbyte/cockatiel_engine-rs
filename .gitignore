# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# ==========================================
# Rust & Cargo Build Artifacts
# ==========================================
# Ignore target directories anywhere in the workspace (parent and submodules)
**/target/
/target/
target/

# Cargo backup and temporary files
**/*.rs.bk
Cargo.lock.install
*.rlib
*.rmeta

# Cargo cache / incremental compilation data
.cargo/
incremental/

# ==========================================
# Database & Runtime Artifacts
# ==========================================
# Local SQLite, RocksDB, or embedded DB files generated by user/timeline databases
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.ldb
*.sst

# Dynamic runtime logs and socket files
*.log
*.sock
*.pid

# Local runtime data overrides (keep tracked template configs safe)
config.local.json
keymap.local.json
*.env
*.env.local

# ==========================================
# Protocol Buffers / Generated Code (If built dynamically via build.rs)
# ==========================================
# Uncomment if build.rs generates proto files dynamically inside src/ or target/
# /src/proto/generated/

# ==========================================
# Editors, Tools & Systems
# ==========================================
# Neovim / Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
.*.swp
.netrwhist

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# JetBrains / RustRover / CLion
.idea/
*.iml

# macOS / OS Artifacts
.DS_Store
._*
Thumbs.db

# Engine runtime config — contains the JWT secret + pairing PIN. Never commit.
config.json
modules.json

# Generated TLS identity (self-signed cert + private key). The engine writes
# these on first boot so clients can pin the cert; the private key must NEVER
# be committed.
tls/
*.pem
*.key
